# Rust
/target
**/*.rs.bk

# 前端构建产物（trunk 输出，由 crates/tr-ui/index.html + 源码重建）
/crates/tr-ui/dist
!/crates/tr-ui/dist/.gitkeep
/crates/tr-ui/.trunk

# Tauri 打包产物
/src-tauri/target
/build/target

# tauri-build 每次构建自动生成的权限 schema
/src-tauri/gen/schemas

# 本地验证用的真实工作空间数据（绝不入库）
/fixtures/private/
*.db
*.db-wal
*.db-shm
# 迁移前的自动备份（`VACUUM INTO` 出来的单文件快照）
*.db.pre-migration-*.bak
transactions.log
# 构建/验证脚本重定向出来的日志（`*> build-0.1.0.log` 这类）
*.log

# 编辑器
.vscode/
.idea/
*.swp
Thumbs.db

# 本机安装的 AI 编码工具 skill：DSH 扫 `/.agents/skills/`（rank 200 的 `project-agents` 根；项目本地覆盖根是
# `/.dsh/skills/`，rank 100）；含 vendored JS/数据，与「界面无 Node、不 vendor JS 库」的约定不符，故不入库；
# 换机重装即可。
/.agents/
